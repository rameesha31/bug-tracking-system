<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">My Projects</h1>
      <p class="text-sm text-slate-500 mt-1">Manage and view your projects</p>
    </div>

    <% if current_user.admin? %>
      <%= link_to " Create Project", new_project_path,
          class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
    <% end %>
  </div>

  <% if @projects.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @projects.each do |project| %>
        <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
          <h2 class="text-lg font-semibold text-slate-800">
            <%= project.name %>
          </h2>

          <p class="text-sm text-slate-500 mt-2">
            <%= truncate(project.description, length: 120) %>
          </p>

          <div class="flex justify-between items-center mt-5">
            <span class="text-sm text-slate-500">
              <%= pluralize(project.bugs.count, "bug") %>
            </span>

            <%= link_to "View Project ", project_path(project),
                class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white border border-slate-200 rounded-xl p-10 text-center">
      <p class="text-slate-500">No projects found.</p>
    </div>
  <% end %>
</div>