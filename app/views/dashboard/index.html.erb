
<div class="space-y-8">

  <!-- Dashboard Heading -->
  <div>
    <h1 class="text-3xl font-bold text-slate-800">
      Welcome, <%= current_user.name %>!
    </h1>
    <p class="text-slate-500 mt-1">
      Here's an overview of your bug tracking activity.
    </p>
  </div>

  <!-- Bug Filters -->
  <div class="bg-white p-6 rounded-xl border shadow-sm">
    <h2 class="text-xl font-bold mb-5">Filter Bugs</h2>

    <%= form_with url: root_path, method: :get, local: true do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">

        <div>
          <%= f.label :q, "Search", class: "block text-sm font-medium mb-2" %>
          <%= f.text_field :q, value: params[:q],
              placeholder: "Search bug title",
              class: "w-full border border-slate-300 rounded-lg p-3" %>
        </div>

        <div>
          <%= f.label :project_id, "Project", class: "block text-sm font-medium mb-2" %>
          <%= f.select :project_id,
              options_from_collection_for_select(@projects, :id, :name, params[:project_id]),
              { include_blank: "All Projects" },
              class: "w-full border border-slate-300 rounded-lg p-3" %>
        </div>

        <div>
          <%= f.label :status, "Status", class: "block text-sm font-medium mb-2" %>
          <%= f.select :status,
              options_for_select(Bug.statuses.keys.map { |s| [s.humanize, s] }, params[:status]),
              { include_blank: "All Statuses" },
              class: "w-full border border-slate-300 rounded-lg p-3" %>
        </div>

        <div>
          <%= f.label :priority, "Priority", class: "block text-sm font-medium mb-2" %>
          <%= f.select :priority,
              options_for_select(Bug.priorities.keys.map { |p| [p.humanize, p] }, params[:priority]),
              { include_blank: "All Priorities" },
              class: "w-full border border-slate-300 rounded-lg p-3" %>
        </div>

        <div>
          <%= f.label :sort, "Sort By", class: "block text-sm font-medium mb-2" %>
          <%= f.select :sort,
              options_for_select([["Newest", "newest"], ["Oldest", "oldest"], ["Title", "title"]], params[:sort]),
              {},
              class: "w-full border border-slate-300 rounded-lg p-3" %>
        </div>

      </div>

      <div class="flex gap-3 mt-5">
        <%= f.submit "Apply Filters",
            class: "bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg font-medium cursor-pointer" %>

        <%= link_to "Clear Filters", root_path,
            class: "bg-slate-100 hover:bg-slate-200 text-slate-700 px-5 py-2.5 rounded-lg font-medium" %>
      </div>
    <% end %>
  </div>

  <!-- Summary Cards -->
  <% if current_user.admin? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <p class="text-sm text-slate-500">Total Projects</p>
        <h2 class="text-3xl font-bold mt-2"><%= @total_projects %></h2>
      </div>

      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <p class="text-sm text-slate-500">Total Bugs</p>
        <h2 class="text-3xl font-bold mt-2"><%= @total_bugs %></h2>
      </div>

    </div>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <p class="text-sm text-slate-500">Total Projects</p>
        <h2 class="text-3xl font-bold mt-2"><%= @total_projects %></h2>
      </div>

      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <p class="text-sm text-slate-500">Total Bugs</p>
        <h2 class="text-3xl font-bold mt-2"><%= @total_bugs %></h2>
      </div>

      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <p class="text-sm text-slate-500">New Bugs</p>
        <h2 class="text-3xl font-bold mt-2"><%= @new_bugs %></h2>
      </div>

      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <p class="text-sm text-slate-500">In Progress</p>
        <h2 class="text-3xl font-bold mt-2"><%= @in_progress_bugs %></h2>
      </div>

      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <p class="text-sm text-slate-500">Resolved Bugs</p>
        <h2 class="text-3xl font-bold mt-2"><%= @resolved_bugs %></h2>
      </div>

      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <p class="text-sm text-slate-500">Assigned to Me</p>
        <h2 class="text-3xl font-bold mt-2"><%= @assigned_bugs.count %></h2>
      </div>

      </div>
    <% end %>

    <% unless current_user.admin? %>
    <% if @assigned_bugs.any? %>
      <div class="bg-white p-6 rounded-xl border shadow-sm">
        <h2 class="text-xl font-bold mb-4">Assigned to Me</h2>

        <% @assigned_bugs.each do |bug| %>
          <div class="border-b last:border-0 py-4 flex justify-between items-center gap-4">
            <div>
              <p class="font-semibold text-slate-800">
                <%= bug.title %>
              </p>

              <p class="text-sm text-slate-500 mt-1">
                Project: <%= bug.project.name %>
                · Priority: <%= bug.priority.humanize %>
              </p>
            </div>

            <span class="text-sm bg-slate-100 px-3 py-1 rounded-full">
              <%= bug.status&.humanize %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <!-- All Bugs -->
  <div class="bg-white p-6 rounded-xl border shadow-sm">
    <h2 class="text-xl font-bold mb-4">All Bugs</h2>

    <% if @bugs.any? %>
      <% @bugs.each do |bug| %>
        <div class="border-b last:border-0 py-4 flex justify-between items-center gap-4">

          <div>
            <p class: "font-semibold text-slate-800 > 
               <%= bug.title %>
            </p>
            <p class="text-sm text-slate-500 mt-1">
              Project: <%= bug.project.name %>
              · Priority: <%= bug.priority.humanize %>
            </p>
          </div>

          <span class="text-sm bg-slate-100 px-3 py-1 rounded-full">
            <%= bug.status&.humanize %>
          </span>

        </div>
      <% end %>
    <% else %>
      <p class="text-slate-500">No bugs found.</p>
    <% end %>
  </div>
</div>
