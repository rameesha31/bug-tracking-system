<%= turbo_frame_tag "bugs_list" do %>

  <div class="bg-white p-6 rounded-xl border shadow-sm">
  <h2 class="text-xl font-bold mb-4">All Bugs</h2>

  <% if @bugs.any? %>
    <% @bugs.each do |bug| %>
      <div class="border-b last:border-0 py-4 flex justify-between items-center gap-4">

        <div>
          <p class="font-semibold text-slate-800" > 
            <%= bug.title %>
          </p>
          <p class="text-sm text-slate-500 mt-1">
            Project: <%= bug.project.name %>
            · Priority: <%= bug.priority.humanize %>
          </p>
        </div>

        <span class="text-sm bg-slate-100 px-3 py-1 rounded-full">
          <%= bug.status&.humanize %>
        </span>

      </div>
    <% end %>
  <% else %>
    <p class="text-slate-500">No bugs found.</p>
  <% end %>
  </div>
<% end %>
