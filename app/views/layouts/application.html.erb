
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bugzilla" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 min-h-screen text-slate-800">

    <nav class="bg-white border-b border-slate-200 shadow-sm">
      <div class="max-w-7xl mx-auto px-6 py-4 flex flex-wrap items-center justify-between gap-4">

        <%= link_to root_path, class: "text-2xl font-bold text-blue-700" do %>
          Bugzilla
        <% end %>

        <% if logged_in? %>
          <div class="flex flex-wrap items-center gap-2">

            <%= link_to "Dashboard", root_path,
                class: "px-4 py-2 rounded-lg font-medium #{current_page?(root_path) ? 'bg-blue-100 text-blue-700' : 'text-slate-600 hover:bg-slate-100'}" %>

            <%= link_to "Projects", projects_path,
                class: "px-4 py-2 rounded-lg font-medium #{controller_name == 'projects' ? 'bg-blue-100 text-blue-700' : 'text-slate-600 hover:bg-slate-100'}" %>

            <%= link_to "Bugs", bugs_path,
                class: "px-4 py-2 rounded-lg font-medium #{controller_name == 'bugs' ? 'bg-blue-100 text-blue-700' : 'text-slate-600 hover:bg-slate-100'}" %>

          </div>

          <div class="flex items-center gap-3 border-l border-slate-200 pl-4">

            <div class="text-right">
              <p class="font-semibold text-sm text-slate-800">
                <%= current_user.name %>
              </p>
              <p class="text-xs text-slate-500">
                <%= current_user.role.humanize %>
              </p>
            </div>

            <%= button_to "Logout", logout_path,
                method: :delete,
                class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium" %>

          </div>
        <% end %>

      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-6 py-8">
      <div id="flash_messages">
        <% if notice.present? %>
          <%= render "shared/flash_message", message: notice, type: :success %>
        <% end %>
      
        <% if alert.present? %>
          <%= render "shared/flash_message", message: alert, type: :error %>
        <% end %>
      </div>

      <%= yield %>
    </main>

  </body>
</html>
