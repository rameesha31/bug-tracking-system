
<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4">
  <div class="w-full max-w-md rounded-xl bg-white p-8 shadow">

    <h1 class="mb-6 text-2xl font-bold text-gray-800">
      Create Account
    </h1>

    <%= form_with model: @user, url: signup_path do |f| %>

      <% if @user.errors.any? %>
        <div class="mb-4 rounded bg-red-100 p-3 text-red-700">
          <% @user.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.label :name, class: "block mb-1 font-medium" %>
        <%= f.text_field :name, class: "w-full rounded border p-2" %>
      </div>

      <div class="mb-4">
        <%= f.label :email, class: "block mb-1 font-medium" %>
        <%= f.email_field :email, class: "w-full rounded border p-2" %>
      </div>
      <div class="mb-4">
        <%= f.label :role, "Select Role" %>
        <%= f.select :role, [["Developer", "developer"], ["Reporter", "reporter"]], { prompt: "Choose your role" }, class: "w-full border rounded p-2" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, class: "block mb-1 font-medium" %>
        <%= f.password_field :password, class: "w-full rounded border p-2" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "Confirm Password", class: "block mb-1 font-medium" %>
        <%= f.password_field :password_confirmation, class: "w-full rounded border p-2" %>
      </div>

      <%= f.submit "Register",
          class: "w-full rounded bg-blue-600 p-2 text-white hover:bg-blue-700" %>

    <% end %>
  </div>
</div>
