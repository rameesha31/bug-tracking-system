<h2 class="text-lg font-semibold text-slate-800 mb-4">Comments</h2>

<div id="comment_form">
  <%= render "comments/form", bug: @bug, comment: Comment.new %>
</div>

<div id="comments_list" class="mt-6 space-y-4">
  <%= render partial: "comments/comment",
      collection: @bug.comments,
      as: :comment %>
</div>