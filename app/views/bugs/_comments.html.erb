<h2 class="text-lg font-semibold text-slate-800 mb-4">Comments</h2>

<%= form_with model: [@bug, Comment.new], class: "space-y-3" do |f| %>
  <%= f.text_area :content, rows: 3, placeholder: "Write a comment...",
      class: "w-full rounded-lg border border-slate-300 px-3 py-2" %>
  <%= f.submit "Add Comment",
      class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm cursor-pointer" %>
<% end %>

<div class="mt-6 space-y-4">
  <% @bug.comments.each do |comment| %>
    <div class="border-t border-slate-100 pt-4">
      <div class="flex justify-between items-start gap-3">
        <div>
          <p class="font-medium text-slate-800"><%= comment.user.name %></p>
          <p class="text-xs text-slate-400"><%= comment.created_at.strftime("%d %b %Y, %I:%M %p") %></p>
        </div>

        <% if current_user.admin? || comment.user_id == current_user.id %>
          <%= button_to "Delete",
              bug_comment_path(@bug, comment),
              method: :delete,
              data: { turbo_confirm: "Delete this comment?" },
              class: "text-red-600 text-xs hover:text-red-800" %>
        <% end %>
      </div>

      <p class="text-slate-600 mt-2 whitespace-pre-line"><%= comment.content %></p>
    </div>
  <% end %>
</div>
</div>
