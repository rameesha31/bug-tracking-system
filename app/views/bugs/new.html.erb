<div class="max-w-2xl mx-auto">
  <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm" data-controller="project-selection">
    <h1 class="text-2xl font-bold text-slate-800 mb-6">Report a New Bug</h1>

    <div class="mb-5">
    <%= label_tag :project_id, "Select Project",
        class: "block text-sm font-medium text-slate-700 mb-2" %>
  
    <%= select_tag :project_id,
        options_from_collection_for_select(@projects, :id, :name),
        prompt: "Choose a project",
        class: "w-full rounded-lg border border-slate-300 px-3 py-2",
        data: {
          project_selection_target: "project",
          action: "change->project-selection#projectChanged"} %>
    </div>
    <div data-project-selection-target="form" class="hidden">
      <hr class="my-6">

      <h2 class="text-lg font-semibold text-slate-800 mb-4">
        Bug Details
      </h2>

      <%= render "form", bug: @bug %>
    </div>
  </div>
</div>