<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Bugs</h1>
      <p class="text-sm text-slate-500 mt-1">View and manage reported bugs</p>
    </div>

    <% if current_user.admin? || current_user.reporter? %>
      <%= link_to " Report Bug", new_bug_path,
          class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium" %>
    <% end %>
  </div>

  <% if @bugs.any? %>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
      <% @bugs.each do |bug| %>
        <div class="p-5 border-b border-slate-100 last:border-0 flex flex-col sm:flex-row sm:justify-between gap-3">
          <div>
            <h2 class="font-semibold text-slate-800"><%= bug.title %></h2>
            <p class="text-sm text-slate-500 mt-1">
              <%= truncate(bug.description, length: 100) %>
            </p>
            <div class="flex flex-wrap gap-2 mt-3">
              <span class="text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded">
                <%= bug.priority.humanize %> Priority
              </span>
              <span class="text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded">
                <%= bug.status.humanize %>
              </span>
              <span class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded">
                <%= bug.project.name %>
              </span>
            </div>
          </div>

          <%= link_to "View Details ", bug_path(bug),
              class: "text-blue-600 hover:text-blue-800 text-sm font-medium self-start" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white border border-slate-200 rounded-xl p-10 text-center">
      <p class="text-slate-500">No bugs found.</p>
    </div>
  <% end %>
</div>