
<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4">
  <div class="w-full max-w-md rounded-xl bg-white p-8 shadow">

    <h1 class="mb-6 text-2xl font-bold text-gray-800">
      Login to Bugzilla
    </h1>

    <%= form_with url: login_path do |f| %>

      <div class="mb-4">
        <%= f.label :email, class: "block mb-1 font-medium" %>
        <%= f.email_field :email, class: "w-full rounded border p-2" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, class: "block mb-1 font-medium" %>
        <%= f.password_field :password, class: "w-full rounded border p-2" %>
      </div>

      <%= f.submit "Login",
          class: "w-full rounded bg-blue-600 p-2 text-white hover:bg-blue-700" %>
    <% end %>

    <p class="mt-4 text-sm">
      Don't have an account?
      <%= link_to "Register", signup_path, class: "text-blue-600" %>
    </p>

  </div>
</div>
